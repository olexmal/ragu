# RAGU Environment Configuration Example
# Copy this file to .env and update with your values

# =============================================================================
# Service Ports
# =============================================================================
API_PORT=8080
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OLLAMA_PORT=11434
FRONTEND_DEV_PORT=4200
FRONTEND_PROD_PORT=80

# =============================================================================
# Backend Dependencies
# =============================================================================

# Redis (Required)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# Kafka (simulated in-memory initially)
KAFKA_BOOTSTRAP=localhost:29092
SCRAPE_REQUESTS_TOPIC=scrape-requests
SCRAPE_PROGRESS_TOPIC=scrape-progress

# Ollama LLM Server
OLLAMA_BASE_URL=http://host.docker.internal:11434
# For Linux Docker: http://172.17.0.1:11434
# For containerized Ollama: http://ollama:11434

# =============================================================================
# HTTP & CORS Configuration
# =============================================================================
QUARKUS_HTTP_PORT=8080
QUARKUS_HTTP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Quarkus Profile (dev, test, prod)
QUARKUS_PROFILE=prod

# =============================================================================
# Authentication & Authorization
# =============================================================================

# Enable/disable authentication
AUTH_ENABLED=false

# Basic auth credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# API Key (set to 'unset' to disable)
AUTH_API_KEY=unset

# Session Management
SESSION_COOKIE_NAME=RAGU_SESSION
SESSION_TIMEOUT_MINUTES=1440

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=30

# =============================================================================
# Document Processing
# =============================================================================
RAGU_DOCUMENT_CHUNK_SIZE=1000
RAGU_DOCUMENT_CHUNK_OVERLAP=200

# =============================================================================
# Embedding Configuration
# =============================================================================
RAGU_EMBEDDING_PROVIDER=ollama
RAGU_EMBEDDING_MODEL=nomic-embed-text
RAGU_EMBEDDING_DIMENSION=768
RAGU_EMBEDDING_CACHE_TTL=3600

# =============================================================================
# LLM Provider Configuration
# =============================================================================
RAGU_LLM_PROVIDER=ollama
RAGU_LLM_MODEL=mistral

# OpenAI (optional)
# OPENAI_API_KEY=sk-...

# Anthropic (optional)
# ANTHROPIC_API_KEY=...

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Google AI (optional)
# GOOGLE_API_KEY=...

# OpenRouter (optional)
# OPENROUTER_API_KEY=...

# =============================================================================
# Vector Store Configuration
# =============================================================================
RAGU_QDRANT_COLLECTION_BASE=common-model-docs
RAGU_QDRANT_API_KEY=

# =============================================================================
# Observability & Logging
# =============================================================================

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Metrics
QUARKUS_MICROMETER_EXPORT_PROMETHEUS_PATH=/q/metrics

# =============================================================================
# Scrape Simulation (Development)
# =============================================================================
RAGU_SCRAPE_SIMULATION_ENABLED=true
RAGU_SCRAPE_SIMULATION_DELAY_MS=100
RAGU_SCRAPE_SIMULATION_CHUNKS=20

# =============================================================================
# Confluence Integration (Optional)
# =============================================================================
# These are stored in Redis via /settings/confluence endpoint
# CONFLUENCE_ENABLED=false
# CONFLUENCE_URL=https://your-domain.atlassian.net
# CONFLUENCE_INSTANCE_TYPE=cloud
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_USERNAME=

# =============================================================================
# Development Options
# =============================================================================
# Enable Quarkus dev services (auto-starts Redis in dev mode)
# QUARKUS_DEVSERVICES_ENABLED=true
